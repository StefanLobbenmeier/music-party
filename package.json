{
  "name": "music-party",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "npm run build && wrangler pages dev ./dist",
    "deploy": "npm run build && wrangler pages deploy ./dist --project-name music-party"
  },
  "dependencies": {
